<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Theme.uss первым: он объявляет переменные, которыми пользуется GameHud.uss.
         Поменяешь порядок — часть цветов не разрешится и молча уйдёт в наследование. -->
    <Style src="Theme.uss" />
    <Style src="GameHud.uss" />

    <ui:VisualElement name="screen" class="screen" picking-mode="Ignore">

        <!-- ===== плашки уровней над грядками =====
             ВНИМАНИЕ, приписка «под панелями» тут врала. Слой объявлен первым, то есть по
             порядку документа обязан рисоваться НИЖЕ `hud`, — а на деле рисуется выше.
             Замер (Shots/pass4/01_game.png): плашка грядки попала на кнопку «Уровни»
             (её рамка 772,27 при кнопке 746,23…827,52); светлота тела плашки внутри кнопки
             83.3 против 82.1 вне её — то есть подложка кнопки (альфа 0.34) плашку НЕ
             притемняет, значит плашка поверх. Почему так — не выяснено.
             Следствие: рассчитывать, что HUD закроет мировой слой, нельзя. Понадобится
             развести — прятать плашку, чья рамка пересекает рамку топбара, а не менять
             местами слои. -->
        <ui:VisualElement name="world-badges" class="world-layer" picking-mode="Ignore" />

        <!-- ===== кольцо прогресса над узлом, который держат рукой ===== -->
        <ui:VisualElement name="gather-ring-layer" class="world-layer" picking-mode="Ignore" />

        <!-- ===== редкое облачко с символом над фермером ===== -->
        <ui:VisualElement name="emote-layer" class="world-layer" picking-mode="Ignore" />

        <!-- ===== всплывающие числа над событиями ===== -->
        <ui:VisualElement name="floating-text" class="world-layer" picking-mode="Ignore" />

        <!-- ===== первый урок: метки над парой и строка внизу ===== -->
        <ui:VisualElement name="merge-hint-layer" class="world-layer" picking-mode="Ignore" />
        <ui:Label name="merge-hint" text="" class="lesson" picking-mode="Ignore" style="display: none;" />
        <ui:Label name="care-hint" text="" class="lesson" picking-mode="Ignore" style="display: none;" />

        <!-- ================= HUD =================
             Клики HUD не перехватывает: picking снимается со всего поддерева разом в
             GameHud.MakeReadout, и обратно его получают только кнопки. Ставить здесь
             picking-mode поэлементно не нужно — забытый элемент вернёт мёртвую зону. -->
        <ui:VisualElement name="hud" class="hud">

            <!-- Крестик закрытия во всех окнах — × (U+00D7), а НЕ ✕ (U+2715). Второго нет в
                 Inter, запасного шрифта у FarmUI.asset тоже нет, и на месте символа рисуется
                 пустой квадрат: игрок не понимает, что окно закрывается кнопкой. Заводишь в
                 интерфейс новый символ — проверь, что он есть в шрифте. -->

            <!-- Топбар переносится (flex-wrap в GameHud.uss): в портрете он просит около 1030
                 логических пикселей при 978 доступных, и три кнопки, включая «В меню», уезжали
                 за экран — из игры нельзя было выйти. -->
            <ui:VisualElement name="topbar" class="topbar">
                <ui:Label name="gold-value" text="0" class="gold" />
                <ui:Label name="clock-value" text="—" class="gold gold--clock" />
                <ui:Label name="water-value" text="" class="gold gold--clock" style="display: none;" />
                <ui:Label name="level-value" text="" class="gold gold--clock" />
                <ui:Label name="guest-title" text="" class="gold guest-title" style="display: none;" />
                <ui:Label name="guest-help" text="" class="gold gold--clock" style="display: none;" />
                <ui:Button name="guest-home" text="Домой" class="btn btn--accent" style="display: none;" />
                <ui:Button name="inventory-button" text="Склад" class="btn" />
                <ui:Button name="shop-button" text="Магазин" class="btn btn--accent" />
                <ui:Button name="friends-button" text="Друзья" class="btn" />
                <ui:Button name="market-button" text="Рынок" class="btn" />
                <ui:Button name="tasks-button" text="Дела" class="btn" />
                <ui:Button name="settings-button" text="Настройки" class="btn" />
                <ui:Button name="badges-button" text="Уровни" class="btn btn--ghost" />
                <ui:Button name="collapse-button" text="Скрыть" class="btn btn--ghost" />
                <ui:Button name="menu-button" text="В меню" class="btn btn--ghost" />
            </ui:VisualElement>

            <ui:VisualElement name="hud-panels" class="hud-panels">

            <ui:VisualElement name="panel-farmer" class="panel">
                <ui:Label text="ФЕРМЕР" class="panel__title" />
                <ui:Label name="farmer-state" text="—" class="row row--strong" />
                <ui:Label name="farmer-thought" text="" class="row row--muted" />

                <ui:VisualElement class="meter">
                    <ui:Label name="satiety-label" text="Сытость" class="meter__label" />
                    <ui:VisualElement class="meter__track">
                        <ui:VisualElement name="satiety-fill" class="meter__fill meter__fill--food" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="meter">
                    <ui:Label name="hydration-label" text="Вода" class="meter__label" />
                    <ui:VisualElement class="meter__track">
                        <ui:VisualElement name="hydration-fill" class="meter__fill meter__fill--water" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="meter">
                    <ui:Label name="energy-label" text="Бодрость" class="meter__label" />
                    <ui:VisualElement class="meter__track">
                        <ui:VisualElement name="energy-fill" class="meter__fill meter__fill--energy" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="meter">
                    <ui:Label name="carry-label" text="Рюкзак" class="meter__label" />
                    <ui:VisualElement class="meter__track">
                        <ui:VisualElement name="carry-fill" class="meter__fill meter__fill--carry" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="farmer-hire" text="" class="row row--muted" />
                <ui:Button name="hire-button" text="Нанять" class="btn btn--accent hire-btn" />
            </ui:VisualElement>

            <ui:VisualElement name="panel-skills" class="panel">
                <ui:Label text="НАВЫКИ" class="panel__title" />
                <ui:VisualElement name="skill-list" class="skill-list" />
                <ui:Label name="skill-next" text="" class="hint" />
            </ui:VisualElement>

            <ui:VisualElement name="panel-farm" class="panel">
                <ui:Label text="ФЕРМА" class="panel__title" />
                <ui:Label name="storage-summary" text="—" class="row" />
                <ui:Label name="plots-ready" text="—" class="row" />
                <ui:Label name="plots-next" text="—" class="row row--muted" />
                <ui:Label name="net-status" text="" class="row row--muted" />

                <!-- Лестница фермы: сколько земли уже своей и чего стоит следующая ступень.
                     Кнопка последней в панели — как наём в панели фермера: строки читают,
                     нажимают одну. -->
                <ui:Label name="farm-level" text="—" class="row" />
                <ui:Label name="farm-level-note" text="" class="row row--muted" />
                <ui:Button name="farm-expand" text="Расширить" class="btn btn--accent hire-btn" />
            </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ================= ПОСТРОЙКА ================= -->
        <!-- Без затемнения и по правому краю: игрок должен видеть саму постройку, пока её улучшает. -->
        <ui:VisualElement name="building-panel" class="building" style="display: none;">
            <ui:VisualElement class="window__header">
                <ui:Label name="building-title" text="" class="window__title" />
                <ui:Button name="building-close" text="×" class="btn btn--icon" />
            </ui:VisualElement>

            <ui:VisualElement class="window__body building__body">
                <ui:VisualElement class="building__head">
                    <ui:VisualElement name="building-icon" class="shop-item__icon" />
                    <ui:VisualElement class="building__headtext">
                        <ui:Label name="building-level" text="" class="row row--strong" />
                        <ui:Label name="building-effect" text="" class="shop-item__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="building-work" class="meter" style="display: none;">
                    <ui:Label name="building-work-label" text="" class="meter__label" />
                    <ui:VisualElement class="meter__track">
                        <ui:VisualElement name="building-work-fill" class="meter__fill meter__fill--carry" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="building-next" class="building__next">
                    <ui:Label text="СЛЕДУЮЩИЙ УРОВЕНЬ" class="panel__title building__section" />
                    <ui:Label name="building-next-note" text="" class="shop-item__desc" />
                    <ui:VisualElement name="building-cost" class="building__cost" />
                    <ui:Button name="building-upgrade" text="Улучшить" class="btn btn--accent building__upgrade" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="building-message" text="" class="window__message window__message--hint" />
        </ui:VisualElement>

        <!-- ================= НАСТРОЙКИ ================= -->
        <ui:VisualElement name="settings-overlay" class="overlay" style="display: none;">
            <ui:VisualElement name="settings-window" class="window window--narrow">
                <ui:VisualElement class="window__header">
                    <ui:Label text="НАСТРОЙКИ" class="window__title" />
                    <ui:Button name="settings-close" text="×" class="btn btn--icon" />
                </ui:VisualElement>

                <ui:VisualElement class="window__body settings">
                    <ui:Label text="ЗВУК" class="panel__title" />

                    <ui:VisualElement class="setting">
                        <ui:Label name="volume-master-label" text="Общая громкость" class="setting__label" />
                        <ui:Slider name="volume-master" low-value="0" high-value="1" value="0.8" class="setting__slider" />
                    </ui:VisualElement>

                    <ui:VisualElement class="setting">
                        <ui:Label name="volume-effects-label" text="Эффекты" class="setting__label" />
                        <ui:Slider name="volume-effects" low-value="0" high-value="1" value="1" class="setting__slider" />
                    </ui:VisualElement>

                    <ui:Button name="volume-test" text="Проверить звук" class="btn" />
                    <ui:Label text="Настройки сохраняются автоматически." class="hint" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= СКЛАД ================= -->
        <ui:VisualElement name="inventory-overlay" class="overlay" style="display: none;">
            <!-- Широкое, как магазин и друзья: на 420 px в ряд вставало четыре ячейки из
                 сорока восьми, и склад читался колодцем. Ширин в сетке две (GameHud.uss),
                 списки берут широкую. -->
            <ui:VisualElement name="inventory-window" class="window">
                <ui:VisualElement class="window__header">
                    <ui:Label text="СКЛАД" class="window__title" />
                    <ui:Label name="inventory-count" text="" class="count" />
                    <ui:Button name="inventory-close" text="×" class="btn btn--icon" />
                </ui:VisualElement>

                <ui:ScrollView name="inventory-scroll" class="window__body">
                    <!-- Пустой склад обязан сказать, что он пуст: сорок восемь одинаковых пустых
                         гнёзд читаются как «не загрузилось», а молчаливое состояние без объяснения
                         в этом проекте считается дефектом. Сетку в этот момент прячем целиком —
                         подпись поверх сетки была бы двумя ответами на один вопрос. -->
                    <ui:Label name="inventory-empty" text="склад пуст — собери урожай" class="vacant" style="display: none;" />
                    <ui:VisualElement name="inventory-grid" class="inv-grid" />
                </ui:ScrollView>

                <!-- Показывается только когда есть что продать (InventoryWindow.Rebuild): совет
                     «кликни по занятой ячейке» над пустой сеткой обещал действие, которого нет. -->
                <ui:Label name="inventory-hint" text="клик по занятой ячейке — продать" class="window__message window__message--hint" style="display: none;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= МАГАЗИН ================= -->
        <ui:VisualElement name="shop-overlay" class="overlay" style="display: none;">
            <ui:VisualElement name="shop-window" class="window">

                <ui:VisualElement class="window__header">
                    <ui:Label text="МАГАЗИН" class="window__title" />
                    <ui:Label name="shop-gold" text="0" class="gold gold--inline" />
                    <ui:Button name="shop-close" text="×" class="btn btn--icon" />
                </ui:VisualElement>

                <ui:VisualElement name="shop-tabs" class="tabs" />

                <ui:ScrollView name="shop-scroll" class="window__body">
                    <ui:VisualElement name="shop-list" class="shop-list" />
                </ui:ScrollView>

                <ui:Label name="shop-message" text="" class="window__message" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= ДРУЗЬЯ ================= -->
        <ui:VisualElement name="friends-overlay" class="overlay" style="display: none;">
            <ui:VisualElement name="friends-window" class="window friends-window">
                <ui:VisualElement class="window__header">
                    <ui:Label name="friends-title" text="ДРУЗЬЯ" class="window__title" />
                    <ui:Button name="friends-close" text="×" class="btn btn--icon" />
                </ui:VisualElement>

                <ui:VisualElement class="window__body">
                    <ui:VisualElement name="friends-add" class="friends-add">
                        <ui:TextField name="friends-name" class="friends-add__field" max-length="24" />
                        <ui:Button name="friends-invite" text="Позвать" class="btn btn--accent" />
                    </ui:VisualElement>

                    <ui:ScrollView name="friends-scroll" class="friends-scroll">
                        <ui:VisualElement name="friends-list" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:Label name="friends-message" text="" class="window__message window__message--hint" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= РЫНОК =================
             Одно окно двумя секциями: свои запасы сверху, чужие лоты ниже. Цены назначает
             сервер от каталога — окно их только показывает. -->
        <ui:VisualElement name="market-overlay" class="overlay" style="display: none;">
            <ui:VisualElement name="market-window" class="window friends-window">
                <ui:VisualElement class="window__header">
                    <ui:Label text="РЫНОК" class="window__title" />
                    <ui:Button name="market-close" text="×" class="btn btn--icon" />
                </ui:VisualElement>

                <ui:ScrollView class="window__body">
                    <ui:VisualElement name="market-list" />
                </ui:ScrollView>

                <ui:Label name="market-message" text="" class="window__message window__message--hint" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= ДЕЛА: ЗАКАЗЫ И УСПЕХИ =================
             Одно окно на две вкладки, а не два окна в топбаре: заказы и вехи — один и тот
             же вопрос «чем сейчас заняться», и разводить их по кнопкам значит заставлять
             игрока помнить, в какой из двух лежит ответ.
             Строка `tasks-note` стоит НАД списком и принадлежит вкладке: у заказов это
             срок доски, у успехов — счётчик взятого. Держать оба числа в шапке нельзя —
             шапка одна, а вкладки две, и второе число читалось бы как чужое. -->
        <ui:VisualElement name="tasks-overlay" class="overlay" style="display: none;">
            <ui:VisualElement name="tasks-window" class="window">
                <ui:VisualElement class="window__header">
                    <ui:Label text="ДЕЛА" class="window__title" />
                    <ui:Button name="tasks-close" text="×" class="btn btn--icon" />
                </ui:VisualElement>

                <ui:VisualElement name="tasks-tabs" class="tabs" />
                <ui:Label name="tasks-note" text="" class="tasks-note" />

                <ui:ScrollView name="tasks-scroll" class="window__body">
                    <ui:VisualElement name="tasks-list" class="tasks-list" />
                </ui:ScrollView>

                <ui:Label name="tasks-message" text="" class="window__message window__message--hint" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= ПОКА ТЕБЯ НЕ БЫЛО ================= -->
        <ui:VisualElement name="inbox-overlay" class="overlay" style="display: none;">
            <ui:VisualElement name="inbox-window" class="window window--narrow">
                <ui:VisualElement class="window__header">
                    <ui:Label text="ПОКА ТЕБЯ НЕ БЫЛО" class="window__title" />
                    <ui:Button name="inbox-close" text="×" class="btn btn--icon" />
                </ui:VisualElement>

                <ui:ScrollView class="window__body">
                    <ui:VisualElement name="inbox-list" />
                </ui:ScrollView>

                <ui:Label text="друзья заходили и оставили след" class="window__message window__message--hint" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== поздравление с вехой =====
             Не модальное окно и не всплывающее число. Веха берётся посреди игры, часто во
             время сбора, — окно поперёк хода раздражает, а `float` над грядкой живёт 1.1 с
             и привязан к точке в мире, которой у вехи нет. Поэтому прибитая табличка под
             топбаром: висит несколько секунд, тает сама, клики не ловит.
             Стоит предпоследним, перед контекстным меню: мировой слой в этом документе
             рисуется поверх HUD (см. приписку наверху), и табличка обязана быть выше его. -->
        <ui:VisualElement name="toast-layer" class="toast-layer" picking-mode="Ignore">
            <ui:Label name="achievement-toast" text="" class="toast" picking-mode="Ignore" style="display: none;" />
        </ui:VisualElement>

        <!-- ===== контекстное меню — последним, чтобы рисовалось поверх окон ===== -->
        <ui:VisualElement name="context-menu" class="ctx" style="display: none;">
            <ui:Label name="ctx-title" text="" class="ctx__title" />
            <ui:VisualElement name="ctx-items" class="ctx__items" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
