/* Палитра и лестницы размеров — единственный источник цвета и кегля во всём интерфейсе.
   Подключается ПЕРВЫМ в GameHud.uxml и MainMenu.uxml; ниже по списку токен вправе
   переопределить только тот, кто объяснит зачем, а завести новый цвет мимо палитры нельзя.

   Почему палитра вообще появилась: до неё в двух USS лежало девяносто с лишним цветов —
   четыре разных золота, три белых, пять зелёных, каждый заведён на глаз и в своём файле.
   Перекрасить такой интерфейс можно было только перебором всех девяноста, а значит —
   нельзя. Теперь ручка одна и она здесь.

   ================= ГЛАВНОЕ ПРАВИЛО =================
   ТЁПЛОЕ — НА ДЕРЕВЕ, ХОЛОДНОЕ — НА ТЁМНОЙ ПАНЕЛИ.

   Доска отражает жёлтый свет: серо-голубой текст на ней выглядит грязным пятном, будто
   краска выцвела. Тёмная стеклянная панель HUD, наоборот, стоит поверх зелёного поля,
   и тёплый текст на ней сливается с фермой. Поэтому у каждой текстовой роли по паре
   токенов — `--ink-warm-*` для дерева, `--ink`/`--muted`/`--faint` для панели, — и путать
   их нельзя: это не вкусовщина, а читаемость.

   Исключение одно и честное: классы, живущие на обеих поверхностях сразу (`.row`, `.hint`,
   `.panel__title` встречаются и в панели HUD, и внутри деревянного окна), берут холодную
   ветку. Доска у нас тёмно-коричневая, холодный на ней читается; тёплый на панели HUD —
   нет. Из двух зол выбрано то, что нигде не ломает текст.

   ================= ЧЕГО ТУТ НЕТ =================
   Лестницы цветов, у которых цвет и есть смысл, в токены не сведены и сведены не будут:
   уровни грядок (.badge--lvl1..5) и полоски потребностей (.meter__fill--*). Там пять
   различимых оттенков — это язык, а не оформление; загнав их в --accent, мы сотрём
   единственный способ увидеть, что с чем сливать, не читая цифру.
*/

/* Три селектора вместо одного :root — не перестраховка, а следствие того, как UI Toolkit
   вешает таблицы стилей. Таблица действует на элемент, к которому прикреплена, и на его
   потомков; корень панели этому поддереву — предок, и полагаться на то, что :root
   дотянется, значит зависеть от внутренностей движка. `.screen` и `.menu` — корни двух
   наших деревьев, и оттуда переменные точно достанут до всех. */
:root, .screen, .menu {

    /* ---- текст на тёмной панели (холодный) ---- */
    --ink: rgb(228, 234, 240);              /* основной: строки табло, названия, поля */
    --ink-hi: rgb(255, 255, 255);           /* чистый белый: числа на фишках и плашках */
    --ink-soft: rgba(228, 234, 240, 0.75);  /* второй голос: подписи полосок, цена ресурса */
    --muted: rgba(228, 234, 240, 0.55);     /* подпись: всё, что читают вторым заходом */
    --faint: rgba(228, 234, 240, 0.35);     /* выключенный пункт меню */

    /* ---- текст на дереве (тёплый) ---- */
    --ink-warm: rgb(252, 240, 220);              /* основной на доске: надписи кнопок */
    --ink-warm-hi: rgb(255, 250, 236);           /* доска под курсором */
    --ink-warm-soft: rgba(246, 232, 210, 0.72);  /* тихая кнопка, подпись ползунка */
    --ink-warm-muted: rgba(246, 232, 210, 0.5);  /* сноска на доске */
    --ink-warm-off: rgba(246, 232, 210, 0.34);   /* выключенная кнопка */

    /* ---- смысловые ---- */
    --gold: rgb(255, 214, 120);          /* золото, числа, заголовки окон — один на все четыре */
    --gold-hint: rgb(255, 236, 150);     /* свет первого урока: кольцо пары и «+» слияния */
    --accent: rgb(150, 210, 165);        /* согласие, успех, хватает ресурса */
    --accent-warm: rgb(186, 226, 158);   /* тот же смысл, но поверх доски — теплее и светлее */
    --accent-wash: rgba(120, 200, 140, 0.22); /* заливка пункта под курсором */
    --ink-on-accent: rgb(250, 255, 240); /* надпись на зелёной доске */
    --danger: rgb(240, 128, 116);        /* отказ, нехватка, необратимое */
    --danger-warm: rgb(255, 214, 202);   /* то же поверх доски */
    --clock: rgb(178, 208, 236);         /* часы: единственное холодное пятно в топбаре —
                                            время не золото и не должно спорить с ним */

    /* ---- поверхности ---- */
    --panel: rgba(26, 19, 13, 0.85);         /* панель HUD: сквозь неё видно ферму */
    --panel-cool: rgba(20, 24, 30, 0.85);    /* мировые плашки и облачко над фермером */
    --panel-cool-edge: rgba(150, 175, 200, 0.45);
    --surface: rgb(30, 36, 45);              /* непрозрачное: контекстное меню, окно постройки */
    --scrim: rgba(8, 10, 14, 0.65);          /* затемнение под окнами.
                                                Здесь стояло 0.55 с припиской «потолок, глубже
                                                ферма перестаёт просвечивать». Приписка не была
                                                проверена замером, а тем временем доску окна
                                                затемнили ради волокна — и по отдельности
                                                защищённые решения вместе стёрли разницу
                                                светлот: окно 60 против травы 54, всего 1.11x.
                                                Окно держалось одним тоном (коричневое на
                                                зелёном); к вечеру, когда ферма темнеет, ему
                                                держаться было бы нечем.
                                                Замер по 13_shop_noon_true (полдень, самый
                                                светлый мир): при 0.65 трава уходит на 44, окно
                                                остаётся 60 — 1.36x, и ферма всё ещё читается
                                                (зелёный тон и разброс травы на месте).
                                                Настоящий потолок ближе к 0.8; трогать это
                                                число — только с замером обоих чисел, светлоты
                                                окна и светлоты травы под ним. */
    --chip: rgba(0, 0, 0, 0.75);             /* подложка числа на иконке */
    --plate-quiet: rgba(8, 10, 14, 0.34);    /* тихая подложка под надписью, сидящей прямо на мире.
                                                Не «доска потише», а другой приём: плоская заливка
                                                без волокна, кромки и гвоздей. Замер по 01_game:
                                                трава под топбаром 139 светлоты, надпись 241 — это
                                                контраст 2.96, буква тонет. Под этой плашкой трава
                                                становится 95, контраст 5.6 — выше, чем даёт доска
                                                кнопке-соседке (3.4), и это не спор с ней: доска
                                                громче не контрастом, а текстурой, теплом и Bold. */
    --plate-quiet-hover: rgba(8, 10, 14, 0.5); /* та же плашка под курсором: доска-соседка
                                                светлеет подменой картинки, плашке светлеть
                                                нечем — отзывается уплотнением */
    --header-shade: rgba(0, 0, 0, 0.28);     /* шапка окна: та же доска, но в тени */
    --field-warm: rgba(20, 13, 8, 0.55);     /* поле ввода, врезанное в доску */

    /* ---- белые вуали: четыре ступени вместо прежних одиннадцати ---- */
    --veil-1: rgba(255, 255, 255, 0.03);  /* едва намечено — пустая ячейка склада */
    --veil-2: rgba(255, 255, 255, 0.06);  /* подложка: ячейка, строка магазина, поле */
    --veil-3: rgba(255, 255, 255, 0.12);  /* дорожки полосок, границы ячеек */
    --veil-4: rgba(255, 255, 255, 0.16);  /* граница поля и меню, ячейка под курсором */

    /* ---- дерево ---- */
    --wood-edge: rgb(150, 108, 62);              /* тёплая окантовка панели HUD */
    --wood-edge-soft: rgba(150, 108, 62, 0.7);
    --wood-line: rgba(255, 226, 180, 0.14);      /* шов между досками */
    --wood-line-strong: rgba(255, 226, 180, 0.25);
    --wood-groove: rgba(28, 18, 11, 0.7);        /* прибитая поперечина */

    /* ---- тени и тонировки кнопок ---- */
    --shadow: rgba(0, 0, 0, 0.65);       /* тень под текстом: буквы на доске иначе тонут в волокнах */
    --shadow-hard: rgba(0, 0, 0, 0.85);  /* обводка мирового текста — под ним бывает что угодно */
    --press: rgb(198, 190, 180);         /* доска под пальцем: тонировка, а не новый спрайт */
    --off: rgb(150, 148, 144);           /* доска выключенной кнопки */

    /* ---- лестница кегля ----
       Шесть ступеней на весь интерфейс. До неё в двух файлах жило четырнадцать размеров
       от 12 до 62, и разница в один пиксель между соседними строками читалась как
       случайность вёрстки, а не как разница в важности. */
    --text-xs: 13px;     /* сноски, подписи полосок, мировые плашки */
    --text-sm: 15px;     /* рабочий текст: кнопки, поля, списки */
    --text-md: 18px;     /* строки табло, заголовки окон, всплывающие числа */
    --text-lg: 22px;     /* золото в топбаре, кнопки меню, заголовки диалогов */
    --text-xl: 28px;     /* единственное крупное — «+» слияния */
    --text-title: 62px;  /* название игры */
}
