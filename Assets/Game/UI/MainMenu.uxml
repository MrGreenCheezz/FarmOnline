<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI/MainMenu.uss" />

    <ui:VisualElement name="menu-root" class="menu">
        <ui:VisualElement name="menu-panel" class="menu__panel">
            <ui:Label text="ФЕРМА" class="menu__title" />
            <ui:Label text="тихое место, где всё растёт само" class="menu__subtitle" />

            <ui:VisualElement class="menu__rule" />

            <ui:Label name="menu-save-info" text="—" class="menu__info" />

            <!-- Форма входа. Видна ровно пока нет токена: у кого он есть, тому нечего вводить,
                 а лишние поля на главном экране читаются как незаконченная работа. -->
            <ui:VisualElement name="menu-auth" class="menu__auth">
                <ui:Label text="имя фермы" class="menu__setting-label" />
                <ui:TextField name="menu-name" class="menu__input" max-length="24" />

                <ui:Label text="пароль" class="menu__setting-label" />
                <ui:TextField name="menu-password" class="menu__input" max-length="64" />

                <ui:Button name="menu-login" text="Войти" class="menu__button menu__button--primary" />
                <ui:Button name="menu-register" text="Завести ферму" class="menu__button" />

                <ui:Label text="сервер пока работает без https — пароль идёт по сети открытым. Возьми здесь отдельный, не тот, что от почты."
                          class="menu__hint" />
            </ui:VisualElement>

            <ui:Button name="menu-continue" text="Играть" class="menu__button menu__button--primary" />
            <ui:Button name="menu-new" text="Новая игра" class="menu__button" />
            <ui:Button name="menu-settings" text="Звук" class="menu__button" />
            <ui:Button name="menu-password-change" text="Сменить пароль" class="menu__button menu__button--quiet" />
            <ui:Button name="menu-switch" text="Сменить игрока" class="menu__button menu__button--quiet" />
            <ui:Button name="menu-quit" text="Выход" class="menu__button menu__button--quiet" />

            <ui:Label name="menu-net-status" text="" class="menu__net-status" />
        </ui:VisualElement>

        <ui:VisualElement name="menu-settings-overlay" class="menu__overlay">
            <ui:VisualElement class="menu__dialog">
                <ui:Label text="Звук" class="menu__dialog-title" />

                <ui:Label name="menu-volume-master-label" text="Общая громкость" class="menu__setting-label" />
                <ui:Slider name="menu-volume-master" low-value="0" high-value="1" value="0.8" class="menu__slider" />

                <ui:Label name="menu-volume-effects-label" text="Эффекты" class="menu__setting-label" />
                <ui:Slider name="menu-volume-effects" low-value="0" high-value="1" value="1" class="menu__slider" />

                <ui:Label text="Настройки сохраняются автоматически и действуют в игре." class="menu__dialog-text" />

                <ui:VisualElement class="menu__dialog-row">
                    <ui:Button name="menu-volume-test" text="Проверить" class="menu__button menu__button--quiet" />
                    <ui:Button name="menu-settings-close" text="Готово" class="menu__button menu__button--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="menu-password-overlay" class="menu__overlay">
            <ui:VisualElement class="menu__dialog">
                <ui:Label text="Смена пароля" class="menu__dialog-title" />
                <ui:Label text="Новый пароль выгонит остальные устройства: тот, кто подсмотрел старый, останется за воротами."
                          class="menu__dialog-text" />

                <ui:Label text="текущий пароль" class="menu__setting-label" />
                <ui:TextField name="menu-pass-current" max-length="64" class="menu__input" />

                <ui:Label text="новый пароль" class="menu__setting-label" />
                <ui:TextField name="menu-pass-next" max-length="64" class="menu__input" />

                <ui:Label text="новый ещё раз" class="menu__setting-label" />
                <ui:TextField name="menu-pass-repeat" max-length="64" class="menu__input" />

                <ui:Label name="menu-pass-message" text="" class="menu__net-status" />

                <ui:VisualElement class="menu__dialog-row">
                    <ui:Button name="menu-pass-close" text="Закрыть" class="menu__button menu__button--quiet" />
                    <ui:Button name="menu-pass-apply" text="Сменить" class="menu__button menu__button--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="menu-confirm" class="menu__overlay">
            <ui:VisualElement class="menu__dialog">
                <ui:Label text="Начать заново?" class="menu__dialog-title" />
                <ui:Label text="Нынешняя ферма будет стёрта без возврата." class="menu__dialog-text" />
                <ui:VisualElement class="menu__dialog-row">
                    <ui:Button name="menu-confirm-no" text="Оставить" class="menu__button menu__button--quiet" />
                    <ui:Button name="menu-confirm-yes" text="Начать заново" class="menu__button menu__button--danger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
