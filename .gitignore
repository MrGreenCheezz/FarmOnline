# ===== Unity — генерируемые папки, восстанавливаются самим редактором =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Burst роняет сюда сгенерированный код при веб-сборке — это вывод, а не исходник
/Data/

# Кэш Visual Scripting
/[Aa]ssets/Plugins/Editor/JetBrains*

# ===== IDE =====
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
